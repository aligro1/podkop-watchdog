#!/bin/sh
#
# podkop-watchdog — спасает интернет, когда прокси podkop умирает.
#
# Зачем: dnsmasq настроен podkop'ом как noresolv=1 + единственный upstream
# 127.0.0.42 (sing-box). Запасного резолвера нет.
#
# Что НЕ является проблемой, проверено на этом роутере 20.08.2026: убитый
# процесс sing-box воскресает сам за 25-30 секунд — respawn прописан не в
# /etc/init.d/podkop, а в /etc/init.d/sing-box, и procd его отрабатывает.
#
# Чего действительно нет — health-check (issue itdoginfo/podkop#111: sing-box
# жив, но DNS не отдаёт ответов; respawn такое не лечит, процесс-то не падал)
# и деградации до прямого трафика при мёртвом VLESS-сервере. Оба случая и
# закрывает этот скрипт.
#
# Почему это ощущается как «пропал ВЕСЬ интернет», хотя прямой трафик цел:
# у владельца включён community-список cloudflare, и в прокси уходит огромная
# доля веба — cloudflare.com, github.com, habr.com, x.com, discord.com.
#
# Логика: проба тянет страницу домена, который РЕАЛЬНО уходит в прокси. Это
# требует одновременно живого DNS от sing-box (резолв в FakeIP 198.18.0.0/15)
# и живого VLESS (по FakeIP надо дойти через туннель). Сдохло любое звено —
# проба падает.
#
# ВАЖНО, проверено на этом роутере 20.08.2026: НЕЛЬЗЯ брать для пробы
# fakeip.podkop.fyi/check. Этот домен получает FakeIP, но соединение уходит
# НАПРЯМУЮ (route.final=direct-out, отдельного route-правила на него нет).
# При наглухо заблокированном VLESS-сервере он продолжал бодро отвечать
# {"fakeip": true}, тогда как cloudflare.com и github.com уже лежали. Проба
# на нём проспала бы падение целиком.
#
# PROBE_HOST подставляется в `sh -c` внутри probe_target_proxied, поэтому
# менять его можно только на обычное доменное имя: кавычки, пробелы и $(...)
# там выполнятся. Сейчас это константа без спецсимволов, так что безопасно.
#
# PROBE_HOST обязан входить в списки podkop. Если выключишь community-список
# cloudflare — смени PROBE_HOST на любой домен, который остаётся в прокси,
# иначе проба потеряет смысл. Скрипт это отслеживает сам (probe_target_proxied)
# и ругается в лог, вместо того чтобы молча гасить podkop зря.
#
# Состояния:
#   armed    — podkop работает, следим
#   degraded — podkop погашен нами, интернет идёт напрямую, ждём оживления
#
# Запуск: из cron раз в минуту. Ставится /usr/bin/podkop-watchdog.

set -u

PROBE_HOST="cloudflare.com"
PROBE_URL="https://cloudflare.com/cdn-cgi/trace"
PROBE_MATCH="^ip="        # что должно найтись в ответе
PROBE_TIMEOUT=10          # сек на одну пробу
# RESTART_AT обязан быть строго меньше STOP_AT: ветка рестарта завершает
# прогон через return, и при равных значениях эскалация в degraded опоздает
# ровно на один цикл.
RESTART_AT=3              # провалов подряд до рестарта podkop
# Если авария мигает — подвисает на минуту, после рестарта на полминуты
# оживает — счётчик провалов обнуляется каждым успехом, и до STOP_AT дело не
# доходит никогда: watchdog вечно дёргает podkop каждые несколько минут, а дом
# получает постоянные обрывы вместо стабильного прямого интернета. Поэтому
# второй рестарт внутри этого окна не делается: сразу гасим.
RESTART_PROBATION=900     # сек, в течение которых повторный рестарт запрещён
STOP_AT=6                 # провалов подряд до гашения podkop
RECOVERY_EVERY=300        # базовый интервал попыток подъёма в degraded, сек
RECOVERY_MAX=1800         # потолок интервала после неудачных попыток, сек
MISCONF_LOG_EVERY=3600    # как часто напоминать, что цель пробы не проксируется
# Не фиксированные паузы, а ПОТОЛОК ожидания: проверяем каждые 5с и выходим
# сразу, как заработало. Живой прогон 24.08.2026 показал, почему это важно:
# холодный старт sing-box с пустым кэшем (после перезагрузки tmpfs пуст) не
# укладывался в прежние 20с, watchdog объявлял «цепочка не работает», гасил
# podkop и удваивал паузу — хотя подъём был на верном пути.
SETTLE_RESTART=60         # потолок ожидания после restart
SETTLE_START=90           # потолок ожидания после start из degraded
FALLBACK_DNS="8.8.8.8"    # если podkop не сохранил оригинал — на что чинить

# Путь бинаря sing-box: спрашиваем систему, литерал только запасным. Зачем
# не литералом — см. комментарий у sing_box_running.
SING_BOX_BIN=$(command -v sing-box 2>/dev/null)
[ -n "$SING_BOX_BIN" ] || SING_BOX_BIN="/usr/bin/sing-box"

STATE_DIR="/tmp/podkop-watchdog"
F_FAILS="$STATE_DIR/fails"
F_MODE="$STATE_DIR/mode"
F_RECOVERY="$STATE_DIR/last_recovery"
F_BACKOFF="$STATE_DIR/backoff"
F_MISCONF="$STATE_DIR/misconf_logged"
F_LAST_RESTART="$STATE_DIR/last_restart"
F_DNS_MOAN="$STATE_DIR/dns_moaned"
F_LOCK="$STATE_DIR/lock"

log() {
    # $1 — уровень (info/warn/err), дальше текст
    local level="$1"; shift
    logger -t podkop-watchdog -p "daemon.$level" -- "$*"
}

# Пустой файл состояния (обрыв питания ровно между усечением и записью) даёт
# fails="", и следующая же арифметика падает. Поэтому дефолт и на пустое тоже.
state_get() {
    local v
    v=$(cat "$1" 2>/dev/null)
    if [ -n "$v" ]; then
        printf '%s\n' "$v"
    else
        printf '%s\n' "$2"
    fi
}
# Запись состояния с подтверждением. Раньше здесь стоял голый `printf > файл`,
# и неудача записи не замечалась НИГДЕ, кроме F_MODE, который перечитывался
# отдельно. Цена молчания максимальная: если /tmp перестал принимать запись
# (tmpfs кончилась память), счётчик провалов застревает. Каждый тик читает
# старое значение, прибавляет единицу в своей переменной, пишет в никуда — и в
# лог уходит правдоподобное «проба провалена (1/6)» раз в минуту. До RESTART_AT
# и STOP_AT дело не доходит НИКОГДА, эскалация не наступает, дом сидит без
# интернета, а по логу видно ровно обратное: будто провалы единичные.
#
# Дросселя тут нет намеренно. Все остальные повторяющиеся жалобы в скрипте
# дросселируются, но эта означает, что скрипт перестал работать вообще — такое
# должно быть видно в логе каждую минуту, а не раз в час.
state_put() {
    printf '%s\n' "$2" > "$1" 2>/dev/null && return 0
    log err "не смог записать $1 — /tmp не принимает запись, эскалация застряла"
    return 1
}

# На этом роутере busybox собран БЕЗ applet'а timeout, а держать вызов
# /etc/init.d/... без ограничения нельзя: подвиснув, он навсегда удержит
# flock, и все следующие минутные прогоны будут молча выходить — watchdog
# умрёт, не сказав об этом ни слова. Поэтому свой ограничитель.
#
# 9>&- обязателен на ОБЕИХ фоновых ветках, и это не перестраховка. Ловил на
# живом роутере: без него подоболочка-таймер наследует fd 9 с блокировкой,
# `kill` снимает саму подоболочку, а её `sleep` остаётся сиротой и продолжает
# держать лок до конца лимита. Прогоны 4, 5 и 6 после рестарта тихо вышли по
# `flock -n`, счётчик застрял на 3, и до гашения podkop дело не дошло вообще.
# Тот же дескриптор наследует и запускаемая команда — init-скрипт с потомками
# удержал бы лок ничуть не хуже.
# setsid делает команду лидером новой группы, чтобы по таймауту снять ВСЁ
# дерево, а не только верхний процесс. Проверено на роутере: без него потомки
# зависшего init-скрипта осиротевают и живут дальше. Лок они уже не держат
# (его закрывает 9>&-), но параллельно править uci-конфиг им ничто не мешает,
# а это гонка с нами же. Если setsid по какой-то причине не сделал команду
# лидером, группы с таким номером просто нет и kill по группе вернёт ошибку —
# на этот случай вторым шагом бьём по обычному pid.
run_bounded() {
    local limit="$1"; shift
    local cmd_pid killer_pid rc
    setsid "$@" >/dev/null 2>&1 9>&- &
    cmd_pid=$!
    # Таймер тоже в своей группе: иначе при снятии подоболочки её `sleep`
    # осиротевает и ещё минуту висит в ps, пугая того, кто полезет разбираться.
    # Лока он не держит (9>&-), но мусор в списке процессов — тоже цена.
    setsid sh -c "sleep $limit; kill -9 -$cmd_pid 2>/dev/null || kill -9 $cmd_pid 2>/dev/null" 9>&- &
    killer_pid=$!
    wait "$cmd_pid" 2>/dev/null
    rc=$?
    kill -9 -"$killer_pid" 2>/dev/null || kill -9 "$killer_pid" 2>/dev/null
    wait "$killer_pid" 2>/dev/null
    if [ "$rc" -gt 128 ]; then
        log err "команда '$*' не уложилась в ${limit}с, снята вместе с потомками"
    fi
    return "$rc"
}

# --- пробы -----------------------------------------------------------------

# Полная цепочка: DNS sing-box -> FakeIP -> tproxy -> VLESS -> интернет.
probe_chain() {
    curl -fsS --max-time "$PROBE_TIMEOUT" "$PROBE_URL" 2>/dev/null \
        | grep -q "$PROBE_MATCH"
}

# Уходит ли домен пробы в прокси на самом деле. Если он вдруг резолвится
# в реальный IP, а не в FakeIP — проба меряет прямой интернет, и по её
# провалу гасить podkop бессмысленно.
# Тоже через ограничитель, и это не формальность: вызывается она сразу после
# успешной probe_singbox_dns, но issue #111 — про ЧАСТИЧНУЮ деградацию, и то,
# что sing-box ответил на предыдущий запрос, ничего не обещает про следующий.
# Незащищённый nslookup здесь подвесил бы весь прогон, держа flock, и все
# дальнейшие тики молча выходили бы — watchdog умер бы ровно в том сценарии,
# ради которого написан. run_bounded глушит stdout, поэтому ответ снимаем
# через файл.
probe_target_proxied() {
    local out ip
    # Имя с PID обязательно: `status` намеренно работает БЕЗ лока, и он тоже
    # зовёт эту функцию. С общим именем он затирал бы файл идущего прогона,
    # тот читал бы обрезанный ответ, решал «домен не проксируется» и СБРАСЫВАЛ
    # счётчик провалов — обнаружение реальной аварии откладывалось бы ровно в
    # ту минуту, когда человек полез смотреть, почему всё легло.
    out="$STATE_DIR/ns.$$.out"
    run_bounded 8 sh -c "nslookup '$PROBE_HOST' 127.0.0.42 > '$out' 2>/dev/null"
    # Берём первый именно IPv4-адрес, а не первый Address подряд. busybox
    # nslookup печатает и A, и AAAA, и порядок блоков не гарантирован: схватив
    # IPv6, функция не совпала бы с 198.18.* и решила «домен не проксируется».
    # Цена такой ошибки максимальная: handle_armed по этому ответу СБРАСЫВАЕТ
    # счётчик провалов, эскалация до рестарта и гашения не наступает никогда, и
    # watchdog молча самоотключается ровно в аварии issue #111, ради которой
    # написан. Сейчас sing-box настроен ipv4_only и AAAA не отдаёт вовсе
    # (проверено, 10 прогонов из 10), но strategy — чужая настройка, и завязка
    # на неё здесь ничем не оправдана.
    # Ищем IPv4 в ЛЮБОМ поле строки, а не только во втором: у части сборок
    # busybox формат «Address 1: 1.2.3.4», и тогда $2 — это «1:», а не адрес.
    # Скрипт ставится на роутеры, куда нет доступа, проверить формат на месте
    # там не получится, а цена промаха — молчащая эскалация.
    ip=$(sed -n '/^Name:/,$p' "$out" 2>/dev/null | awk '
        /^Address/ { for (i = 2; i <= NF; i++)
                         if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { print $i; exit } }')
    rm -f "$out"
    case "$ip" in
        198.18.*) return 0 ;;
        *)        return 1 ;;
    esac
}

# Хост VLESS-сервера из конфига podkop, в виде "host:port".
# Ключи и UUID не трогаем и никуда не пишем — берём только адрес.
proxy_endpoint() {
    local s ps_val ep
    for s in $(uci -q show podkop | sed -n 's/^podkop\.\([a-z0-9_]*\)=section$/\1/p'); do
        ps_val=$(uci -q get "podkop.$s.proxy_string") || continue
        [ -n "$ps_val" ] || continue
        ep=$(printf '%s' "$ps_val" \
            | sed -e 's|^[a-z0-9+.-]*://||' -e 's|^[^@]*@||' -e 's|[?#/].*||')
        # Разбор рассчитан на схему scheme://creds@host:port (vless, и это
        # единственный формат, который тут используется). У legacy ss:// весь
        # секрет лежит одним base64-блоком БЕЗ '@' — тогда sed вернёт его
        # целиком, и `status` напечатает пароль открытым текстом. Поэтому
        # отдаём результат, только если он и правда похож на host:port.
        case "$ep" in
            ""|*[!]A-Za-z0-9.:_[-]*) continue ;;
            *:*) [ "${#ep}" -le 80 ] && { printf '%s' "$ep"; return 0; } ;;
        esac
    done
    return 1
}

# Жив ли сам сервер на TCP-уровне. busybox nc умеет только "nc IP PORT"
# (ни -z, ни -w), поэтому проверяем curl'ом. Успех считаем ТОЛЬКО по rc=0:
# перечислять коды «недоступен» списком нельзя — в него легко не попасть.
# Например rc=6 (имя не резолвится) до TCP вообще не доходит, но при подходе
# «всё, кроме 7 и 28, значит дошло» читался бы как живой сервер.
# Сервер за REALITY на rc=0 отвечает штатно: TLS поднимается до сайта-маскировки.
probe_proxy_host() {
    local ep
    ep=$(proxy_endpoint) || {
        log warn "не удалось разобрать адрес прокси из конфига — пробую поднять podkop вслепую"
        return 0
    }
    [ -n "$ep" ] || return 0
    curl -sk --connect-timeout 6 --max-time 8 -o /dev/null "https://$ep" 2>/dev/null
}

# Цепочка работает И трафик реально идёт в туннель. Вторая половина
# обязательна: если podkop не смог перехватить dnsmasq, цель пробы резолвится
# в реальный IP и curl проходит НАПРЯМУЮ — probe_chain вернёт успех при
# полностью нерабочем прокси. Без этой проверки watchdog объявил бы
# восстановление, ушёл в armed и больше не пробовал бы вообще.
chain_really_proxied() {
    probe_target_proxied && probe_chain
}

# Ждём выполнения условия до limit секунд, проверяя каждые 5.
#
# Отсчёт ПО ЧАСАМ, а не по числу пауз, и это не педантизм: сама проверка стоит
# времени — chain_really_proxied до 18с (probe_target_proxied 8 + probe_chain
# 10), probe_singbox_dns до 8с. Счётчик, растущий на длительность одного sleep,
# врал бы втрое: при заявленном потолке в 60с ожидание уезжало бы к 150с, и всё
# это время удерживался бы общий flock — то есть дольше, чем при фиксированной
# паузе, от которой уходили. Ровно в аварии issue #111 (DNS молчит, каждая
# проверка упирается в свой потолок) это и проявилось бы.
#
# Потолок относится к моменту НАЧАЛА очередной проверки: сама она не
# прерывается, поэтому фактическое ожидание превышает лимит на её длительность.
# Замерено на роутере: лимит 20с и проверка по 7с дают 31с (прежняя арифметика
# дала бы ~48с). Для вызывающего это значит, что limit — ориентир, а не жёсткая
# граница; жёсткая нужна только внутри run_bounded, где она и есть.
wait_until() {
    local limit="$1"; shift
    local start now
    start=$(date +%s)
    while :; do
        "$@" && return 0
        now=$(date +%s)
        # Часы без RTC прыгают назад после первой NTP-синхронизации: считаем,
        # что отсчёт начался заново, иначе ожидание оборвётся мгновенно.
        [ "$now" -lt "$start" ] && start="$now"
        [ $((now - start)) -ge "$limit" ] && return 1
        sleep 5
    done
}

wait_for_chain() { wait_until "$1" chain_really_proxied; }

# Условие «загрузка удалась»: процесс поднялся и его DNS отвечает.
boot_dns_ready() { sing_box_running && probe_singbox_dns; }

# Отвечает ли DNS-сервер sing-box. Обязательно через ограничитель: у busybox
# nslookup НЕТ флагов таймаута (проверено, `nslookup --help` знает только
# -type и -debug), а зависший sing-box порт держит открытым и не отвечает —
# ровно сценарий issue #111. Без ограничителя проверка залипла бы именно тогда,
# когда она нужнее всего.
probe_singbox_dns() {
    run_bounded 8 nslookup fakeip.podkop.fyi 127.0.0.42
}

# Проверено на роутере: busybox `pgrep -x sing-box` НЕ находит живой процесс,
# а `pgrep -f 'sing-box run'` наоборот ловит лишнее — любую оболочку, у которой
# эта строка попала в аргументы (так я один раз убил собственную ssh-сессию).
# Поэтому grep по полному пути бинаря.
#
# Путь берём у системы, а не литералом. Раньше здесь стоял зашитый
# /usr/bin/sing-box, и на роутере с другой раскладкой пакета проверка ВСЕГДА
# отвечала «процесс не найден»: boot_dns_ready не становилась истинной никогда,
# и handle_boot гасил podkop после каждой перезагрузки — при полностью здоровом
# туннеле и с неверным диагнозом «podkop не поднялся» в логе.
# `grep -v grep` вместо скобки в шаблоне: путь теперь переменная, и вставить
# скобку внутрь него без лишнего sed не выйдет.
sing_box_running() {
    ps w 2>/dev/null | grep -v grep | grep -q "$SING_BOX_BIN run"
}

# --- аварийное восстановление DNS ------------------------------------------

# Правила перехвата podkop живут в отдельной таблице inet PodkopTable —
# по её наличию видно, заворачивается ли ещё трафик в sing-box.
podkop_intercept_active() {
    nft list table inet PodkopTable >/dev/null 2>&1
}

# Читаем ФАЙЛ, а не `uci get`. Разница не косметическая: uci мержит поверх диска
# ещё не сброшенные staged-правки из /tmp/.uci. Если `uci commit` не записался
# (флеш переполнен, /etc только для чтения), staged-значение останется в журнале,
# и `uci get` покажет починенный конфиг, которого на диске нет. Эта функция —
# единственный триггер, решающий, надо ли вообще чинить DNS: ослепнув, она
# оставит человека без резолва на неопределённый срок, а в лог напишет, что
# чинить нечего. Ровно тот случай, ради которого watchdog и гасит podkop.
# Ищем именно строку `list server '127.0.0.42'`, а не адрес где угодно в файле.
# Голый grep по адресу срабатывал бы и на комментарии, и на второй секции
# dnsmasq (гостевая сеть), а последствие максимальное: force_restore_dns счёл
# бы здоровую @dnsmasq[0] сломанной и переписал бы ей список серверов на
# FALLBACK_DNS, снеся реальный. В лог при этом ушло бы бодрое «резолв работает».
# Привязать проверку к НОМЕРУ секции всё равно нельзя — в файле секции не
# пронумерованы, — но podkop и сам работает только с @dnsmasq[0].
dnsmasq_on_podkop() {
    grep -qE "^[[:space:]]*list[[:space:]]+server[[:space:]]+'?\"?127\.0\.0\.42" \
        /etc/config/dhcp 2>/dev/null
}

# Поднят ли флаг shutdown_correctly НА ДИСКЕ.
#
# Читаем файл, а не `uci get`, и это не педантизм: тот мержит поверх диска ещё
# не сброшенные staged-правки из /tmp/.uci. Раньше через `uci get` читался сам
# guard «надо ли чинить флаг», и это давало худшую из ловушек: если наш прежний
# `uci commit podkop` не записался (флеш переполнен, /etc только для чтения),
# застрявшее в журнале значение 1 маскировало неудачу. Guard решал «уже
# починено» и пропускал ВЕСЬ блок — вместе с проверкой, которая должна была
# поймать провал. На диске навсегда оставался 0, каждый следующий podkop start
# молча не настраивал dnsmasq, и в логе не появлялось ни строчки.
#
# Формат значения uci не гарантирован: встречаются '1', "1" и голое 1.
podkop_shutdown_flag_up() {
    grep -qE "^[[:space:]]*option[[:space:]]+shutdown_correctly[[:space:]]+'?\"?1'?\"?[[:space:]]*$" \
        /etc/config/podkop 2>/dev/null
}

# Страховка на случай, если podkop упал некорректно и не вернул dnsmasq
# оригинальные значения. Вызывать ТОЛЬКО когда podkop заведомо остановлен.
#
# Разобрано по исходнику /usr/bin/podkop (функции dnsmasq_configure и
# dnsmasq_restore) — воспроизводим ВСЁ, что делает штатное восстановление,
# иначе получится хуже, чем не вмешиваться:
#
#  * podkop.settings.shutdown_correctly — флаг «dnsmasq сейчас в исходном
#    состоянии»: 0 ставится при старте, 1 при остановке. dnsmasq_configure
#    при 0 МОЛЧА выходит, ничего не настраивая. Починить dnsmasq и не поднять
#    флаг = следующий podkop start пройдёт впустую: sing-box поднимется,
#    dnsmasq останется прямым, и в туннель не уйдёт вообще ничего. Тихо,
#    без единой ошибки в логе. Это и есть худший из возможных исходов.
#  * podkop_server/podkop_noresolv/podkop_cachesize — поля бэкапа. podkop
#    кладёт их через uci_add_list и удаляет при восстановлении. Не удалим их
#    следом за ним — при следующем старте список задвоится.
#  * cachesize podkop тоже подменяет (150 -> 0). Не вернём — dnsmasq останется
#    без кэша, и прямой резолв будет заметно медленнее.
force_restore_dns() {
    local orig_srv orig_nr orig_cs srv dns_touched=0 now last

    # В отличие от ddns здесь мы НЕ отступаем перед чужими правками: без DNS дом
    # сидит прямо сейчас, а незакоммиченная правка в LuCI подождёт. Но в лог
    # говорим прямо, что применили её заодно — иначе человек будет искать,
    # откуда взялись изменения, которых он не подтверждал.
    if uci_has_foreign_changes dhcp || uci_has_foreign_changes podkop; then
        log warn "в журнале uci есть чужие незакоммиченные правки — мой commit применит и их (вернуть DNS важнее, чем ждать)"
    fi

    # Две половины разделены НАМЕРЕННО, а не для красоты. Раньше вся функция
    # стояла за общим `dnsmasq_on_podkop || return 0`, и это давало ловушку:
    # если скрипт убьют между `uci commit dhcp` и `uci commit podkop` (kill,
    # OOM, обрыв питания — /etc/config не на tmpfs, коммит переживёт ребут),
    # то dhcp уже починен, а флаг остался в 0. На повторном вызове общий guard
    # видел, что dnsmasq уже не на 127.0.0.42, и выходил первой строкой — флаг
    # не чинился НИКОГДА. Дальше podkop start молча пропускает настройку
    # dnsmasq, туннель не работает, а watchdog вечно крутит «поднял — не
    # работает — погасил». Проверка флага обязана быть независимой.
    if dnsmasq_on_podkop; then
        orig_srv=$(uci -q get dhcp.@dnsmasq[0].podkop_server)
        orig_nr=$(uci -q get dhcp.@dnsmasq[0].podkop_noresolv)
        orig_cs=$(uci -q get dhcp.@dnsmasq[0].podkop_cachesize)

        # Список server переписывается целиком: если рядом с 127.0.0.42 кто-то
        # руками дописал свой DNS, он потеряется. Осознанный размен — вернуть
        # интернет гарантированно важнее, чем сохранить ручную правку.
        # uci -q get для list-опции отдаёт значения построчно, дефолтный IFS
        # разбивает и по переводу строки — цикл ниже корректен.
        uci -q delete dhcp.@dnsmasq[0].server
        if [ -n "$orig_srv" ]; then
            for srv in $orig_srv; do
                uci add_list dhcp.@dnsmasq[0].server="$srv"
            done
        else
            uci add_list dhcp.@dnsmasq[0].server="$FALLBACK_DNS"
        fi
        uci set dhcp.@dnsmasq[0].noresolv="${orig_nr:-0}"
        uci set dhcp.@dnsmasq[0].cachesize="${orig_cs:-150}"
        uci -q delete dhcp.@dnsmasq[0].podkop_server
        uci -q delete dhcp.@dnsmasq[0].podkop_noresolv
        uci -q delete dhcp.@dnsmasq[0].podkop_cachesize
        run_bounded 25 uci commit dhcp
        # Перечитываем с диска, как и флаг ниже. Итоговая проверка резолва в
        # конце функции провал поймает в любом случае, но не назовёт причину —
        # а человеку без доступа к роутеру разница между «не записался конфиг»
        # и «сломана сеть» решает, куда вообще смотреть.
        # Читаем ФАЙЛ, а не `uci get`: тот мержит ещё не сброшенные staged-правки
        # из /tmp/.uci поверх диска и в целевом сценарии («/etc только для
        # чтения») показал бы новое значение, которого на диске нет — проверка
        # молчала бы именно там, ради чего написана.
        # Через дроссель: handle_degraded зовёт эту функцию КАЖДУЮ минуту, а
        # состояние «флеш переполнен» держится сутками. Без ограничения это до
        # 1440 одинаковых строк в сутки — ровно в тот инцидент, когда лог нужен
        # читаемым больше всего. Остальные повторяющиеся жалобы в скрипте
        # дросселируются по тому же принципу.
        if dnsmasq_on_podkop; then
            now=$(date +%s)
            last=$(state_get "$F_DNS_MOAN" 0)
            [ "$now" -lt "$last" ] && last=0
            if [ $((now - last)) -ge "$MISCONF_LOG_EVERY" ]; then
                state_put "$F_DNS_MOAN" "$now"
                log err "uci commit dhcp не записался: в файле всё ещё 127.0.0.42, флеш переполнен или /etc только для чтения"
            fi
        fi
        dns_touched=1
    fi

    if ! podkop_shutdown_flag_up; then
        uci set podkop.settings.shutdown_correctly=1
        run_bounded 25 uci commit podkop
        # Перечитываем именно ФАЙЛ, а не `uci get`: тот подмешал бы собственную
        # staged-правку и отрапортовал об успехе, даже если коммит не лёг на
        # диск. Цена незамеченной неудачи здесь — молча неработающий туннель
        # после следующего старта podkop.
        if podkop_shutdown_flag_up; then
            log warn "поднят флаг shutdown_correctly — иначе следующий podkop start не настроил бы dnsmasq"
        else
            log err "НЕ удалось поднять флаг shutdown_correctly — следующий podkop start не настроит dnsmasq"
        fi
    fi

    [ "$dns_touched" = 1 ] || return 0

    run_bounded 30 /etc/init.d/dnsmasq restart

    # dnsmasq после restart поднимается не мгновенно, и проверка сразу после
    # вызова врёт. Даём ему секунды и говорим в лог правду: восстановление
    # без подтверждённого резолва — это не восстановление, а надежда.
    sleep 3
    if run_bounded 8 nslookup openwrt.org 127.0.0.1; then
        log err "dnsmasq возвращён на ${orig_srv:-$FALLBACK_DNS} (noresolv=${orig_nr:-0}), резолв работает"
    else
        log err "dnsmasq возвращён на ${orig_srv:-$FALLBACK_DNS}, но резолв НЕ работает — смотри /etc/config/dhcp вручную"
    fi
}

# Остановка podkop с проверкой, что она действительно случилась.
#
# Просто позвать stop и поверить на слово нельзя. Если stop подвис и был убит
# по таймауту, а dnsmasq мы при этом починили, получается худшая из картин:
# DNS выглядит здоровым, а правила перехвата на месте — и трафик к ПОДСЕТЯМ
# из списков (они матчатся по IP и от смены DNS не зависят) продолжает уходить
# в tproxy на мёртвый sing-box. Пользователь видит «интернет вроде есть, но
# половина сайтов не грузится» и не имеет ни одной подсказки почему.
podkop_down() {
    run_bounded 45 /etc/init.d/podkop stop || log err "podkop stop завершился нештатно"
    sleep 3
    force_restore_dns

    if podkop_intercept_active; then
        log err "правила PodkopTable уцелели после stop — сношу вручную"
        if nft delete table inet PodkopTable 2>/dev/null; then
            log info "PodkopTable снесена, перехват снят"
        else
            log err "снести PodkopTable не удалось: часть трафика уходит в никуда"
        fi
    fi
    if sing_box_running; then
        # Просто убить процесс бесполезно: respawn прописан в собственном
        # init-скрипте sing-box, procd поднимет его обратно. Останавливаем
        # именно сервис. podkop при следующем старте запустит его сам.
        log warn "sing-box пережил остановку podkop — останавливаю его сервис"
        run_bounded 30 /etc/init.d/sing-box stop
        sleep 2
        if sing_box_running; then
            log err "sing-box не останавливается, разбирайся вручную"
        fi
    fi
}

# --- режимы ----------------------------------------------------------------

# Есть ли в журнале uci чужие незакоммиченные правки. Появляются они так:
# человек нажал в LuCI «Save», но не дошёл до «Save & Apply». Наш `uci commit`
# сбрасывает журнал ЦЕЛИКОМ, то есть применил бы чужую недоделанную правку
# заодно со своей — в том числе поломанную, из-за которой её и не применили.
uci_has_foreign_changes() {
    [ -n "$(uci changes "$1" 2>/dev/null)" ]
}

# Отметка «podkop только что перезапускали». Ставится при КАЖДОМ рестарте, а не
# только в ветке RESTART_AT: иначе рестарт из загрузки или из смены адреса не
# виден защите от флапа, и она разрешит ещё один рестарт через минуту — ровно то
# частое дёрганье podkop, от которого защита и заведена.
mark_restart() { state_put "$F_LAST_RESTART" "$(date +%s)"; }

# Перевод в degraded: podkop погашен, дом на прямом интернете. Вынесено в
# функцию, потому что путей сюда три (шесть провалов, мигающая авария,
# неудачная загрузка), и разъехавшись они оставили бы разное состояние —
# например, невыставленный backoff означал бы попытки подъёма каждую минуту.
go_degraded() {
    podkop_down
    state_put "$F_MODE" degraded
    # Перечитываем: если запись не легла, следующий тик снова пойдёт в
    # handle_armed, начнёт растить счётчик с нуля и через несколько минут
    # повторно погасит уже погашенный podkop. Не авария (podkop_down
    # идемпотентен), но вход в цикл восстановления откладывается, а по логу это
    # выглядит необъяснимо.
    if [ "$(state_get "$F_MODE" armed)" != "degraded" ]; then
        log err "не смог записать режим degraded в $F_MODE — /tmp не принимает запись, восстановление будет буксовать"
    fi
    state_put "$F_FAILS" 0
    state_put "$F_RECOVERY" "$(date +%s)"
    state_put "$F_BACKOFF" "$RECOVERY_EVERY"
    if probe_singbox_dns; then
        log warn "127.0.0.42 всё ещё отвечает — sing-box не остановился полностью"
    fi
    log info "режим degraded: интернет напрямую, проверяю прокси раз в ${RECOVERY_EVERY}с"
}

handle_armed() {
    local fails now last_moan last_restart
    fails=$(state_get "$F_FAILS" 0)

    if probe_chain; then
        if [ "$fails" -gt 0 ]; then
            log info "проба прошла, счётчик сброшен (было провалов: $fails)"
        fi
        state_put "$F_FAILS" 0
        return 0
    fi

    # Проба упала. Прежде чем винить прокси — убедимся, что она вообще про него.
    # Если DNS от sing-box жив, но домен пробы резолвится не в FakeIP, значит
    # он выпал из списков podkop и уходит напрямую. Тогда провал пробы означает
    # поломку прямого интернета, и гашение podkop делу не поможет — только
    # лишит прокси. Ничего не делаем, но громко пишем в лог.
    if probe_singbox_dns && ! probe_target_proxied; then
        # Состояние может держаться сутками (сняли список cloudflare и забыли
        # про PROBE_HOST). Без ограничения это тысячи одинаковых строк в
        # syslog, в которых утонет всё остальное. Напоминаем раз в час.
        now=$(date +%s)
        last_moan=$(state_get "$F_MISCONF" 0)
        if [ "$now" -lt "$last_moan" ] || [ $((now - last_moan)) -ge "$MISCONF_LOG_EVERY" ]; then
            state_put "$F_MISCONF" "$now"
            log err "$PROBE_HOST не проксируется — проба ничего не проверяет, правь PROBE_HOST в /usr/bin/podkop-watchdog"
        fi
        state_put "$F_FAILS" 0
        return 0
    fi

    fails=$((fails + 1))
    state_put "$F_FAILS" "$fails"
    log warn "проба провалена ($fails/$STOP_AT)"

    if [ "$fails" -eq "$RESTART_AT" ]; then
        now=$(date +%s)
        last_restart=$(state_get "$F_LAST_RESTART" 0)
        # Часы без RTC прыгают назад после первой NTP-синхронизации — та же
        # защита, что в handle_degraded.
        [ "$now" -lt "$last_restart" ] && last_restart=0
        if [ "$last_restart" -gt 0 ] && [ $((now - last_restart)) -lt "$RESTART_PROBATION" ]; then
            log err "снова $RESTART_AT провала, а прошлый рестарт был $((now - last_restart))с назад — авария мигает, гашу podkop"
            go_degraded
            return 0
        fi
        mark_restart
        log warn "$RESTART_AT провала подряд — перезапускаю podkop"
        run_bounded 60 /etc/init.d/podkop restart
        if wait_for_chain "$SETTLE_RESTART"; then
            state_put "$F_FAILS" 0
            log info "рестарт помог, прокси снова работает"
        else
            log warn "рестарт не помог за ${SETTLE_RESTART}с, продолжаю следить"
        fi
        return 0
    fi

    if [ "$fails" -ge "$STOP_AT" ]; then
        log err "$STOP_AT провалов подряд — гашу podkop, трафик пойдёт напрямую"
        go_degraded
    fi
}

handle_degraded() {
    local now last wait_for next

    # ПЕРВЫМ делом — независимо от прокси и от таймеров. Если первое гашение
    # не смогло вернуть dnsmasq (force_restore_dns это честно допускает и
    # пишет «резолв НЕ работает»), то починить его больше некому: всё ниже
    # висит за probe_proxy_host, а при надолго умершем сервере туда просто
    # не доходит. Человек остался бы без прямого DNS на неопределённый срок,
    # хотя ровно ради этого watchdog и гасил podkop. Функция идемпотентна,
    # на здоровом роутере это пустой вызов.
    if dnsmasq_on_podkop; then
        log err "в degraded, а dnsmasq всё ещё смотрит в 127.0.0.42 — повторяю восстановление"
        force_restore_dns
    fi

    now=$(date +%s)
    last=$(state_get "$F_RECOVERY" 0)
    wait_for=$(state_get "$F_BACKOFF" "$RECOVERY_EVERY")

    # Часы на роутере без RTC прыгают назад после первой NTP-синхронизации.
    # Отрицательная разница означала бы «ждать вечно» по знаку и «пора прямо
    # сейчас» по факту — просто считаем, что срок настал, и переставляем метку.
    if [ "$now" -lt "$last" ]; then
        log warn "часы прыгнули назад, сбрасываю отсчёт попыток"
        last=0
    fi
    [ $((now - last)) -lt "$wait_for" ] && return 0
    state_put "$F_RECOVERY" "$now"

    if ! probe_proxy_host; then
        return 0
    fi
    log info "прокси-хост снова отвечает, поднимаю podkop"

    run_bounded 60 /etc/init.d/podkop start

    if wait_for_chain "$SETTLE_START"; then
        state_put "$F_MODE" armed
        state_put "$F_FAILS" 0
        state_put "$F_BACKOFF" "$RECOVERY_EVERY"
        # Прошлый рестарт относился к уже закрытой аварии: не давать ему
        # запрещать первый рестарт в следующей.
        state_put "$F_LAST_RESTART" 0
        log info "podkop восстановлен, режим armed"
    else
        # Хост отвечает по TCP, а цепочка не работает: протух ключ, сменился
        # порт, сервер жив но прокси на нём лежит. Долбить каждые 5 минут
        # бессмысленно и вредно — каждая попытка это start/stop podkop с
        # рывком связи. Поэтому удваиваем паузу до потолка.
        next=$((wait_for * 2))
        [ "$next" -gt "$RECOVERY_MAX" ] && next="$RECOVERY_MAX"
        state_put "$F_BACKOFF" "$next"
        log warn "podkop поднялся, но цепочка не работает — гашу обратно, следующая попытка через ${next}с"
        podkop_down
    fi
}

# Проверка после загрузки: issue itdoginfo/podkop#376 — podkop не стартует,
# dnsmasq при этом уже смотрит в мёртвый 127.0.0.42, и интернета нет совсем.
handle_boot() {
    local started
    dnsmasq_on_podkop || { log info "загрузка: dnsmasq не на podkop, вмешательство не нужно"; return 0; }
    if sing_box_running && probe_singbox_dns; then
        # Раньше здесь стояло «всё в порядке» — и это была ложь. Живой DNS
        # sing-box ничего не говорит про туннель: FakeIP он отдаёт и при
        # наглухо мёртвом VLESS. Если роутер перезагрузился, пока сервер лежит,
        # лог рапортовал бы «всё в порядке» при полностью нерабочих доменах из
        # списков. Эскалацию оставляем обычному минутному циклу (рестарт на
        # 3-м провале, гашение на 6-м) — второй путь эскалации здесь только
        # мешал бы, — но в лог говорим правду.
        if probe_chain; then
            log info "загрузка: podkop работает, туннель проверен"
        else
            log warn "загрузка: sing-box отвечает, но туннель не работает — дальше разберётся обычная проверка"
        fi
        return 0
    fi
    log err "загрузка: dnsmasq смотрит в 127.0.0.42, а sing-box не отвечает — чиню"
    mark_restart
    run_bounded 60 /etc/init.d/podkop restart
    # Ожидание с ранним выходом, а не фиксированная пауза — тот же принцип, что
    # у SETTLE_RESTART выше, и здесь он важнее всего: именно на загрузке кэш
    # rule-set пуст и старт растягивается. Фиксированная пауза держала бы общий
    # flock все 60с даже при подъёме за 5с, и минутные тики `check`, попавшие в
    # это окно, молча проигрывали бы `flock -n` — обнаружение аварии тормозило
    # бы ровно в первые минуты после ребута, когда счёт идёт на секунды.
    started=$(date +%s)
    if wait_until "$SETTLE_RESTART" boot_dns_ready; then
        # Ждём именно boot_dns_ready, а не цепочку целиком: на загрузке кэш
        # rule-set пуст, туннель поднимается дольше, и по неготовой цепочке
        # уводить дом в degraded было бы преждевременно. Но сказать «DNS
        # работает» и замолчать — та же ложь, которую уже чинили в ветке выше:
        # живой DNS sing-box отдаёт FakeIP и при наглухо мёртвом VLESS. Поэтому
        # проверяем цепочку отдельно и пишем в лог правду, а эскалацию оставляем
        # обычному минутному циклу.
        if probe_chain; then
            log info "загрузка: podkop поднят за $(( $(date +%s) - started ))с, туннель проверен"
        else
            log warn "загрузка: podkop поднят за $(( $(date +%s) - started ))с, DNS отвечает, но туннель не работает — дальше разберётся обычная проверка"
        fi
    else
        log err "загрузка: podkop не поднялся за ${SETTLE_RESTART}с — возвращаю прямой DNS"
        go_degraded
    fi
}

# --- синхронизация адреса прокси с доменом ---------------------------------
#
# Зачем это вообще нужно, если можно просто вписать домен в proxy_string.
#
# podkop генерит sing-box'у "route.default_domain_resolver": "dns-server", а
# dns-server у нас — открытый udp/53 наружу. Провайдер режет его выборочно:
# в логе 24.08.2026 при аптайме в 21 минуту лежали запросы к домену самого прокси,
# wikipedia.org, debian.org и pool.ntp.org, каждый по 10-45с с "context
# deadline exceeded". При этом nslookup к тому же 8.8.8.8 из шелла роутера
# отвечает мгновенно — то есть путь именно sing-box, а не сеть вообще.
#
# С доменом в адресе сервера этот резолв встаёт ПЕРЕД подъёмом туннеля, а на
# холодном кэше rule-set ещё и блокирует старт sing-box синхронно: community-
# списки качаются с download_detour=main-out, то есть через туннель, которого
# ещё нет. Петля замыкается, sing-box уходит в крэш-луп, dnsmasq остаётся на
# мёртвом 127.0.0.42 — и роутер стоит без интернета целиком.
#
# Поэтому в конфиг podkop кладётся свежий IP, а домен синк помнит за него сам.
#
# Вводится домен ТОЛЬКО через LuCI, как обычная ссылка подключения — отдельного
# места настройки нет и заводить его не нужно. Синк оставляет в proxy_string
# исключительно IP, поэтому домен там может появиться единственным способом:
# его вписал человек. Увидев домен, синк запоминает его в $DDNS_CONF и меняет
# на IP. Файл — память скрипта, а не форма ввода; править руками можно, но не
# требуется.
# Резолвим сами и мимо sing-box — явным адресом резолвера в nslookup. Трафик
# самого роутера podkop не перехватывает (source_network_interfaces=br-lan,
# это про форвард из LAN), проверено: запрос к 9.9.9.9 из шелла проходит и
# тогда, когда sing-box молчит.

DDNS_CONF="/etc/podkop-ddns.conf"   # память: какой домен стоит за адресом секции
DDNS_BAK="/etc/podkop-ddns.bak"
DDNS_BAK_KEEP=100         # строк истории замен; файл во флеше, поэтому с потолком
DDNS_RESOLVER1="9.9.9.9"
DDNS_RESOLVER2="1.1.1.1"
DDNS_MOAN_EVERY=3600      # как часто напоминать, что резолв не удался
F_DDNS_MOAN="$STATE_DIR/ddns_moaned"

# Годится ли адрес на роль публичного VLESS-сервера.
#
# 198.18.0.0/15 в списке исключений — не формальность: это FakeIP-пул sing-box.
# Если резолвер по недосмотру окажется podkop'овским 127.0.0.42, оттуда придёт
# именно такой адрес, и мы пропишем в конфиг указатель на самих себя. Туннель
# после этого не поднимется никогда, а причина будет выглядеть как «сервер
# умер».
ddns_valid_public_ipv4() {
    local ip="$1" rest o1 o2 o3 o4 o
    case "$ip" in
        ""|*[!0-9.]*|*..*|.*|*.) return 1 ;;
    esac
    # Ровно три точки — отказ на понятном условии, а не через побочный эффект
    # разбора. Страховка двойная: "1.2.3" и "1.2.3.4.5" отсеются и ниже, на
    # проверке `case "$o4" in *.*`, куда попадёт остаток с точкой внутри
    # (проверено прогоном с убранной этой строкой — поведение не изменилось).
    # Дубль оставлен намеренно: он читается по месту, а не требует
    # прослеживать, что сделает разбор с некорректным входом.
    case "$ip" in
        *.*.*.*.*) return 1 ;;
        *.*.*.*) ;;
        *) return 1 ;;
    esac
    o1="${ip%%.*}"; rest="${ip#*.}"
    o2="${rest%%.*}"; rest="${rest#*.}"
    o3="${rest%%.*}"; o4="${rest#*.}"
    case "$o4" in ""|*.*) return 1 ;; esac
    for o in "$o1" "$o2" "$o3" "$o4"; do
        [ -n "$o" ] && [ "${#o}" -le 3 ] || return 1
        # Ведущие нули: "010" часть оболочек считает восьмеричным, и сравнение
        # даёт не то, что написано. Снимаем их до арифметики.
        o=$(printf '%s' "$o" | sed 's/^0*//'); [ -n "$o" ] || o=0
        [ "$o" -le 255 ] || return 1
    done
    case "$ip" in
        0.*|10.*|127.*|169.254.*|192.168.*|198.18.*|198.19.*) return 1 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 1 ;;
        100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 1 ;;
        22[4-9].*|23[0-9].*|24[0-9].*|25[0-5].*) return 1 ;;
        # TEST-NET-1/2/3 и 6to4-anycast: в настоящем конфиге их быть не может,
        # а вот в чужом примере или подсунутом ответе — запросто.
        192.0.2.*|198.51.100.*|203.0.113.*|192.88.99.*) return 1 ;;
    esac
    return 0
}

# Все годные A-записи домена через ОДИН указанный резолвер.
# Через ограничитель, потому что у busybox nslookup нет флагов таймаута, а
# run_bounded глушит stdout — ответ приходится снимать через файл. PID в имени
# не про гонку: сюда попадают только из-под общего flock, параллельного прогона
# быть не может. Он на случай, если синк однажды позовут в обход лока — как это
# уже сделано для `status`, у которого свой файл ровно по этой причине.
ddns_resolve() {
    local domain="$1" server="$2" out ips ip
    out="$STATE_DIR/ddns.$$.out"
    run_bounded 10 sh -c "nslookup '$domain' '$server' > '$out' 2>/dev/null"
    ips=$(sed -n '/^Name:/,$p' "$out" 2>/dev/null | awk '
        /^Address/ { for (i = 2; i <= NF; i++)
                         if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print $i }')
    rm -f "$out"
    for ip in $ips; do
        ddns_valid_public_ipv4 "$ip" && printf '%s\n' "$ip"
    done
}

ddns_list_has() {
    local list="$1" needle="$2" x
    [ -n "$needle" ] || return 1
    for x in $list; do [ "$x" = "$needle" ] && return 0; done
    return 1
}

ddns_intersect() {
    local a="$1" b="$2" x
    for x in $a; do ddns_list_has "$b" "$x" && printf '%s\n' "$x"; done
}

# Разбор vless://uuid@host:port?params#tag на части. Меняем потом ТОЛЬКО хост:
# uuid, ключи, sni и fragment не пересобираются, поэтому ошибка разбора не
# может превратиться в потерю параметров подключения — она приведёт к отказу.
ddns_parse_url() {
    local url="$1" rest hostport
    DDNS_PRE=""; DDNS_HOST=""; DDNS_PORT=""; DDNS_POST=""
    case "$url" in *://*@*) ;; *) return 1 ;; esac
    DDNS_PRE="${url%%@*}"
    rest="${url#*@}"
    # Второго '@' в vless-ссылке быть не должно. Есть — разбор ненадёжен, и
    # безопаснее не трогать строку вовсе, чем угадывать.
    case "$rest" in *@*) return 1 ;; esac
    hostport="${rest%%[?#/]*}"
    DDNS_POST="${rest#"$hostport"}"
    case "$hostport" in
        \[*) return 1 ;;    # IPv6 в скобках не поддерживаем
        *:*) ;;
        *) return 1 ;;
    esac
    DDNS_PORT="${hostport##*:}"
    DDNS_HOST="${hostport%:*}"
    case "$DDNS_PORT" in ""|*[!0-9]*) return 1 ;; esac
    [ -n "$DDNS_HOST" ] || return 1
    return 0
}

# Жалоба с дросселем: неудачный резолв может держаться сутками (лёг провайдер,
# уехал домен), а тик раз в 5 минут — это 288 одинаковых строк в syslog за
# сутки, в которых утонет всё остальное.
ddns_moan() {
    local now last
    now=$(date +%s)
    last=$(state_get "$F_DDNS_MOAN" 0)
    # Часы без RTC прыгают назад после первой NTP-синхронизации — та же защита,
    # что в handle_degraded.
    [ "$now" -lt "$last" ] && last=0
    [ $((now - last)) -lt "$DDNS_MOAN_EVERY" ] && return 0
    state_put "$F_DDNS_MOAN" "$now"
    log warn "$*"
}

# История замен во флеше. Без неё после автоматической подмены не восстановить,
# что стояло раньше, — а понадобится это ровно тогда, когда новый адрес окажется
# чужим и надо будет откатываться руками.
ddns_backup() {
    local section="$1" old="$2" new="$3" url="$4" tmp
    tmp="$DDNS_BAK.new"
    {
        [ -f "$DDNS_BAK" ] && tail -n "$DDNS_BAK_KEEP" "$DDNS_BAK"
        echo "# $(date '+%Y-%m-%d %H:%M %Z') $section: $old -> $new"
        echo "$url"
    } > "$tmp" 2>/dev/null && mv "$tmp" "$DDNS_BAK"
}

# Похоже ли на IPv4-литерал. Именно ФОРМАТ, без проверки на публичность:
# вопрос здесь другой — «человек вписал домен или адрес», а не «годится ли
# адрес». Для второго есть ddns_valid_public_ipv4.
ddns_is_ipv4_literal() {
    case "$1" in
        *[!0-9.]*)   return 1 ;;
        *.*.*.*.*)   return 1 ;;
        *.*.*.*)     return 0 ;;
        *)           return 1 ;;
    esac
}

# Имя домена уходит в `sh -c` внутри ddns_resolve, поэтому набор символов узкий:
# кавычки, пробелы и $(...) там выполнились бы. Ведущий дефис отсекаем отдельно —
# busybox nslookup примет "-evil.com" за флаг и упадёт с невнятным сообщением
# вместо честного отказа валидации. Точка обязательна: без неё это не домен.
# Правка из-под Windows оставит в конце \r, он тоже отсеется здесь.
ddns_valid_domain() {
    case "$1" in
        ""|-*|*[!A-Za-z0-9.-]*) return 1 ;;
    esac
    # Точка обязательна, и последняя метка — только буквы. Без этого "12.34"
    # (опечатка в адресе) не пройдёт проверку на IPv4-литерал, свалится в ветку
    # «домен» и будет запомнено навсегда как домен, который «просто не
    # резолвится» — вместо честного «это не похоже ни на IP, ни на домен».
    case "$1" in
        *.*) case "${1##*.}" in ""|*[!A-Za-z]*) return 1 ;; esac; return 0 ;;
    esac
    return 1
}

# Секции podkop, у которых вообще есть подключение.
# Паттерн имени ОБЯЗАН совпадать с proxy_endpoint: разъедутся — секция будет
# синхронизироваться, но не показываться в `status`, и наоборот.
ddns_sections() {
    uci -q show podkop | sed -n 's/^podkop\.\([a-z0-9_]*\)=section$/\1/p'
}

# Строка памяти: "<секция> <домен> <IP, который синк поставил сам>".
# Третье поле — не украшение, а единственный способ отличить «этот IP вписал
# синк» от «этот IP вписал человек». Без него получалась тихая поломка: секция
# была на домене, синк запомнил домен и поставил IP; потом человек меняет в
# LuCI сервер, задавая его сразу адресом, — а синк видит IP-литерал, достаёт из
# памяти СТАРЫЙ домен и переписывает свежий адрес обратно на старый сервер,
# сохранив новые uuid и ключи. Со второго тика он ещё и замолкает, потому что
# адрес уже «совпадает» с резолвом. Человек видит только «новый сервер не
# работает» и ни строчки в логе. Прочерк в третьем поле = IP пока не наш.
ddns_conf_get() {
    [ -f "$DDNS_CONF" ] || return 1
    awk -v s="$1" '$1 == s { print $2; exit }' "$DDNS_CONF"
}

# IP, который синк сам записал в эту секцию. Пусто — значит не записывал.
ddns_conf_get_ip() {
    local v
    [ -f "$DDNS_CONF" ] || return 1
    v=$(awk -v s="$1" '$1 == s { print $3; exit }' "$DDNS_CONF")
    [ "$v" = "-" ] && v=""
    printf '%s' "$v"
}

ddns_conf_del() {
    local section="$1" tmp
    [ -f "$DDNS_CONF" ] || return 0
    tmp="$DDNS_CONF.new"
    awk -v s="$section" '$1 != s' "$DDNS_CONF" > "$tmp" 2>/dev/null \
        && mv "$tmp" "$DDNS_CONF" \
        || log err "ddns: не смог очистить запись секции '$section' в $DDNS_CONF"
}

# Запомнить домен секции. Пишем только при изменении: файл лежит во флеше, а
# тик идёт раз в 5 минут — переписывать его вхолостую 288 раз в сутки незачем.
ddns_conf_set() {
    local section="$1" domain="$2" ip="${3:--}" tmp prev prev_ip
    [ -n "$ip" ] || ip="-"
    prev=$(ddns_conf_get "$section")
    prev_ip=$(ddns_conf_get_ip "$section")
    [ -z "$prev_ip" ] && prev_ip="-"
    [ "$prev" = "$domain" ] && [ "$prev_ip" = "$ip" ] && return 0
    tmp="$DDNS_CONF.new"
    {
        if [ -f "$DDNS_CONF" ]; then
            # Строку этой секции заменяем, чужие и комментарии сохраняем как есть.
            awk -v s="$section" '$1 != s' "$DDNS_CONF"
        else
            echo "# Память podkop-watchdog: какой домен стоит за адресом сервера."
            echo "# Заполняется САМ, когда ты вписываешь ссылку с доменом в LuCI."
            echo "# Отдельно настраивать ничего не нужно."
            echo "# Формат: <секция> <домен> <IP, поставленный синком; '-' если нет>"
        fi
        echo "$section $domain $ip"
    } > "$tmp" 2>/dev/null && mv "$tmp" "$DDNS_CONF" || {
        log err "ddns: не смог записать $DDNS_CONF — домен $domain для '$section' не запомнен"
        return 1
    }
    [ "$prev" = "$domain" ] || \
        log info "ddns: запомнил домен $domain для секции '$section' — взят из proxy_string"
}

# proxy_string приходит параметром, а не читается заново: handle_ddns уже
# сделала по нему свой вывод (домен это или IP), и второе чтение дало бы два
# независимых снимка одного изменяемого состояния. Успей LuCI закоммитить
# правку между ними — решение принималось бы по старой версии, а применялось
# к новой, то есть ровно та подмена адреса, от которой всё это писалось.
ddns_sync_one() {
    local section="$1" domain="$2" ps="$3"
    local cur ips1 ips2 new

    # Смена адреса — дело не срочное: если человек прямо сейчас правит конфиг в
    # LuCI, подождём следующего тика через пять минут. В аварийном
    # восстановлении DNS решение обратное, см. force_restore_dns.
    if uci_has_foreign_changes podkop; then
        ddns_moan "ddns: в конфиге podkop есть незакоммиченные правки (кто-то в LuCI?) — адрес не трогаю до следующего тика. Если LuCI закрыт, а строка повторяется — это мог не записаться наш собственный commit: смотри 'df /overlay' и 'uci changes podkop'"
        return 1
    fi

    ddns_parse_url "$ps" || {
        ddns_moan "ddns: не разобрал proxy_string секции '$section' — адрес не трогаю"
        return 1
    }
    cur="$DDNS_HOST"

    # Сначала один резолвер: в 99% тиков адрес не менялся, и второй запрос
    # был бы чистым расходом. Совпало — выходим, ничего не делая.
    ips1=$(ddns_resolve "$domain" "$DDNS_RESOLVER1")
    ddns_list_has "$ips1" "$cur" && return 0

    ips2=$(ddns_resolve "$domain" "$DDNS_RESOLVER2")
    ddns_list_has "$ips2" "$cur" && return 0

    # Ни один не подтвердил текущий адрес. Менять будем только на то, с чем
    # согласны ОБА: одиночный ответ может быть подменой на стороне провайдера
    # или отравленным кэшем, а цена ошибки — весь проксируемый трафик дома,
    # отправленный на чужой сервер.
    new=$(ddns_intersect "$ips1" "$ips2" | head -1)
    if [ -z "$new" ]; then
        ddns_moan "ddns: $domain — резолверы не сошлись ($DDNS_RESOLVER1: $(echo ${ips1:-нет ответа}); $DDNS_RESOLVER2: $(echo ${ips2:-нет ответа})), адрес не меняю"
        return 1
    fi

    log warn "ddns: $domain теперь $new (в конфиге было $cur) — обновляю podkop.$section"
    # Бэкап может не записаться (переполнен флеш, /etc в read-only), и узнать
    # об этом надо именно сейчас: дальше идёт необратимая правка конфига, ради
    # отката которой бэкап и заводился. Прежний хост пишем в лог — по нему
    # откат восстановим руками. Саму строку не пишем: в ней uuid и ключи.
    ddns_backup "$section" "$cur" "$new" "$ps" \
        || log err "ddns: не сохранил прежний адрес в $DDNS_BAK — отката не будет, прежний хост был $cur"
    uci set "podkop.$section.proxy_string=${DDNS_PRE}@${new}:${DDNS_PORT}${DDNS_POST}"
    if ! run_bounded 20 uci commit podkop; then
        log err "ddns: uci commit podkop не прошёл, адрес не применён"
        return 1
    fi
    state_put "$F_DDNS_MOAN" 0

    # Запоминаем, что этот адрес поставили МЫ. Со следующего тика по нему видно,
    # трогал ли конфиг человек. Порядок важен: сначала конфиг, потом память —
    # если убьют между ними, память отстанет на одну правку, и синк осторожно
    # забудет домен вместо того, чтобы подменить адрес вслепую.
    ddns_conf_set "$section" "$domain" "$new"

    if [ "$(state_get "$F_MODE" armed)" = "degraded" ]; then
        # podkop сейчас погашен НАМЕРЕННО, и поднимать его — не наше дело:
        # у handle_degraded свой порядок проверок и свой backoff, а два
        # start'а подряд дадут гонку за один и тот же init-скрипт. Но повод
        # надеяться появился, поэтому сбрасываем отсчёт: пусть ближайший
        # минутный тик попробует подняться с новым адресом, а не через полчаса.
        state_put "$F_BACKOFF" "$RECOVERY_EVERY"
        state_put "$F_RECOVERY" 0
        log info "ddns: режим degraded — подъём оставляю watchdog'у, отсчёт сброшен"
        return 0
    fi

    mark_restart
    run_bounded 60 /etc/init.d/podkop restart
    if wait_for_chain "$SETTLE_RESTART"; then
        state_put "$F_FAILS" 0
        log info "ddns: podkop перезапущен на $new, цепочка работает"
    else
        # Откатывать некуда: старый адрес не отвечает по определению, иначе мы
        # бы сюда не пришли. Оставляем новый и отдаём разбираться watchdog'у —
        # он либо дождётся подъёма, либо переведёт дом на прямой интернет.
        log err "ddns: на $new цепочка не поднялась за ${SETTLE_RESTART}с — дальше по обычной эскалации"
    fi
}

# Рассчитано на одну-две проксируемые секции, и это осознанный потолок.
# Каждая секция, которой понадобилось обновление, стоит внутри общего flock до
# ~160с (резолв + commit + restart + ожидание цепочки), и все они обходятся
# последовательно. На пяти секциях, у которых IP уехал разом, лок удерживался
# бы дольше, чем ждёт минутный `check` — а именно он умеет довести дело до
# degraded и вернуть дому прямой интернет. Появятся секции — выносить рестарт
# из цикла и делать его один раз в конце.
#
# Идём по секциям podkop, а не по строкам $DDNS_CONF: источник правды — то, что
# человек вписал в LuCI. Запись в файле, для которой секции больше нет, просто
# лежит мёртвым грузом и ни на что не влияет.
handle_ddns() {
    local section ps host domain known

    for section in $(ddns_sections); do
        ps=$(uci -q get "podkop.$section.proxy_string")
        [ -n "$ps" ] || continue
        ddns_parse_url "$ps" || {
            ddns_moan "ddns: не разобрал proxy_string секции '$section' — пропускаю"
            continue
        }
        host="$DDNS_HOST"

        if ddns_is_ipv4_literal "$host"; then
            # Адрес приведён к IP. Домен берём из памяти, но только убедившись,
            # что этот IP поставили мы сами: иначе человек сменил сервер, задав
            # его сразу адресом, память устарела, и синк молча вернул бы старый.
            domain=$(ddns_conf_get "$section")
            [ -n "$domain" ] || continue
            known=$(ddns_conf_get_ip "$section")
            if [ -z "$known" ]; then
                log warn "ddns: в памяти секции '$section' нет нашего IP, а в конфиге стоит $host — считаю правкой руками, забываю домен $domain"
                ddns_conf_del "$section"
                continue
            fi
            if [ "$known" != "$host" ]; then
                log warn "ddns: адрес секции '$section' сменили руками ($known -> $host) — забываю домен $domain, впиши новый через LuCI если он нужен"
                ddns_conf_del "$section"
                continue
            fi
        else
            # Домен в proxy_string мог взяться единственным способом: его вписали
            # руками через LuCI, потому что синк оставляет здесь только IP. Значит
            # это всегда свежая правка, и прежнюю запись надо ЗАМЕНИТЬ, а не
            # предпочесть ей. Иначе смена сервера на другой домен кончится тем,
            # что новые uuid и ключи получат IP старого сервера — такая смесь не
            # работает, а причина по логам не читается вообще.
            # Через дроссель, а не прямым log err: битая ручная правка держится
            # сколько угодно, а тик идёт раз в 5 минут — это 288 одинаковых
            # строк в сутки, в которых утонет всё остальное.
            ddns_valid_domain "$host" || {
                ddns_moan "ddns: '$host' в секции '$section' не похож ни на IP, ни на домен — пропускаю"
                continue
            }
            # IP пока не наш: подменим — тогда и запишем третьим полем.
            ddns_conf_set "$section" "$host" "-"
            domain="$host"
        fi

        ddns_valid_domain "$domain" || {
            ddns_moan "ddns: подозрительное имя '$domain' в $DDNS_CONF, секция '$section' пропущена"
            continue
        }
        ddns_sync_one "$section" "$domain" "$ps"
    done
}

# --- точка входа -----------------------------------------------------------

mkdir -p "$STATE_DIR"

# Один экземпляр за раз: прогон с рестартом длится до ~35с, а ветка подъёма
# из degraded в худшем случае (start не помог, откат обратно) — около 150с,
# то есть заведомо дольше минутного тика cron. Пропущенные тики тихо выходят
# по flock -n, это штатно; в логе они выглядят как «пропавшие» минуты.
action="${1:-check}"

# Проверяем ИМЯ до того, как браться за блокировку. Иначе опечатка вроде
# `podkop-watchdog statuss` уходила бы в общую ветку, натыкалась на занятый лок
# и молча завершалась с кодом 0 — человек, которому по телефону диктуют
# команду, видел бы пустой экран вместо подсказки.
case "$action" in
    check|boot|ddns|status|"") ;;
    *) echo "usage: $0 [check|boot|ddns|status]" >&2; exit 1 ;;
esac

# status — только чтение, и звать его будут как раз тогда, когда идёт долгий
# прогон (человек полез смотреть, «почему всё легло»). Под общей блокировкой
# он бы молча напечатал пустоту. Поэтому лок для него не берём.
if [ "$action" = "boot" ]; then
    exec 9>"$F_LOCK"
    # boot — разовая проверка, второго шанса до следующей перезагрузки нет.
    # Она запускается по таймеру из /etc/rc.local и легко попадает в ту же
    # секунду, что и минутный тик cron. С флагом -n она молча проиграла бы
    # гонку и не выполнилась вообще — то есть защита от issue #376 работала бы
    # через раз. Поэтому здесь ждём очереди, а не выходим.
    # busybox flock умеет только [-sxun], флага ожидания -w у него нет
    # (проверено: `flock --help` его не показывает), поэтому ждём циклом.
    boot_wait=0
    while ! flock -n 9; do
        boot_wait=$((boot_wait + 1))
        if [ "$boot_wait" -ge 24 ]; then
            log err "загрузка: за 120с не дождался блокировки, проверка пропущена"
            exit 0
        fi
        sleep 5
    done
elif [ "$action" = "ddns" ]; then
    exec 9>"$F_LOCK"
    # Тик синка раз в 5 минут против минутного тика watchdog. С флагом -n синк
    # систематически проигрывал бы затяжным прогонам (ветка degraded длится до
    # ~150с) и в аварии — когда он нужнее всего — не работал бы вообще.
    # Поэтому ждём очереди, но недолго: пропущенный тик вернётся через 5 минут.
    ddns_wait=0
    while ! flock -n 9; do
        ddns_wait=$((ddns_wait + 1))
        if [ "$ddns_wait" -ge 12 ]; then
            log warn "ddns: за 60с не дождался блокировки, тик пропущен"
            exit 0
        fi
        sleep 5
    done
elif [ "$action" != "status" ]; then
    exec 9>"$F_LOCK"
    flock -n 9 || exit 0
fi

case "$action" in
    boot)
        # Сначала синк, потом проверка загрузки. Адрес сервера мог уехать, пока
        # роутер стоял выключенным: тогда handle_boot рестартует podkop со
        # старым IP, гарантированно провалится и уведёт дом в degraded — а
        # исправить это смог бы только ближайший пятиминутный тик синка.
        handle_ddns
        handle_boot
        ;;
    status)
        echo "режим:      $(state_get "$F_MODE" armed)"
        echo "провалов:   $(state_get "$F_FAILS" 0)"
        echo "прокси:     $(proxy_endpoint || echo '(не распознан)')"
        echo "цель пробы: $PROBE_HOST"
        printf 'проксируется: '
        if probe_target_proxied; then echo "да (FakeIP)"; else echo "НЕТ — проба бесполезна!"; fi
        printf 'проба:      '
        if probe_chain; then echo "OK"; else echo "ПРОВАЛ"; fi
        printf 'sing-box:   '
        if probe_singbox_dns; then echo "DNS отвечает"; else echo "DNS молчит"; fi
        # Обе проверки завязаны на литералы — путь бинаря и имя nft-таблицы.
        # Сменит их новая версия podkop, и скрипт решит, что всё мертво, ничего
        # об этом не сказав. Показываем их явно: по телефону это единственный
        # способ отличить «прокси лежит» от «скрипт ослеп».
        printf 'процесс:    '
        if sing_box_running; then
            echo "sing-box найден ($SING_BOX_BIN)"
        else
            echo "sing-box НЕ найден (искал $SING_BOX_BIN)"
        fi
        printf 'перехват:   '
        if podkop_intercept_active; then echo "PodkopTable на месте"; else echo "PodkopTable НЕТ"; fi
        printf 'dnsmasq:    '
        uci -q get dhcp.@dnsmasq[0].server | tr '\n' ' '; echo
        printf 'ddns:       '
        if [ -f "$DDNS_CONF" ]; then
            grep -v '^[[:space:]]*#' "$DDNS_CONF" | grep -v '^[[:space:]]*$' | tr '\n' ';' ; echo
        else
            echo "не настроен ($DDNS_CONF нет)"
        fi
        ;;
    ddns)
        handle_ddns
        ;;
    check|"")
        if [ "$(state_get "$F_MODE" armed)" = "degraded" ]; then
            handle_degraded
        else
            handle_armed
        fi
        ;;
    *)
        echo "usage: $0 [check|boot|ddns|status]" >&2
        exit 1
        ;;
esac
